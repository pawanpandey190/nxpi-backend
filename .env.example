# =============================================================================
# NXPI Monolith Backend — Environment Configuration
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=local                            # local | staging | production
APP_NAME=nxpi-backend
APP_PORT=8000
APP_DEBUG=true
APP_VERSION=1.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nxpi_admin:localpassword@localhost:5432/nxpi_db
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OTP Configuration ────────────────────────────────────────────────────────
OTP_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─── Email Provider (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_123456789_placeholder
FROM_EMAIL=noreply@negentrophi.com
FROM_NAME=Negentrophi

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=DEBUG
